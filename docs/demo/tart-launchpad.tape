Output "/tmp/tart-launchpad.gif"

Set FontSize 24
Set Width 1200
Set Height 700
Set Theme "Dracula"
Set TypingSpeed 0
Set CursorBlink false
Set PlaybackSpeed 0.75
Env PATH "/tmp/tart-launchpad-mock-bin:/opt/homebrew/bin:/usr/bin:/bin"

Type "/tmp/tart-launchpad"
Enter
Sleep 4s
Screenshot "/tmp/tart-launchpad.png"
Sleep 2s
Enter
Sleep 3s
Enter
Sleep 4s
